SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=1

# Use DB_ENGINE=sqlserver to connect to the shared HCNS_Manager database.
# The screenshot's server is 192.168.1.69\QA-204. Keep credentials outside source control.
DB_ENGINE=sqlserver
DB_SERVER=192.168.1.69\QA-204
DB_NAME=HCNS_Manager
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_USER=
DB_PASSWORD=
# For Windows authentication, leave DB_USER and DB_PASSWORD blank.
DB_ENCRYPT=yes
DB_TRUST_CERT=yes

# Local fallback (set DB_ENGINE=sqlite)
SQLITE_PATH=instance/hcns_manager.db
